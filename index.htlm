<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no"/>
<meta name="apple-mobile-web-app-capable" content="yes"/>
<meta name="apple-mobile-web-app-title" content="LM Mariages"/>
<link rel="apple-touch-icon" href="data:image/jpeg;base64,"/>
<title>Planning Mariages</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{background:#f5f5f5;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#1a1a1a;font-size:15px;}
input,select,textarea,button{font-family:inherit;font-size:15px;}
button{cursor:pointer;-webkit-appearance:none;}
textarea{resize:vertical;}

/* Pages */
.page{display:none;position:fixed;inset:0;overflow-y:auto;background:#f5f5f5;}
.page.active{display:block;}

/* Login */
#login-screen{position:fixed;inset:0;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:200;padding:40px 30px;max-width:480px;margin:0 auto;}
#login-screen img{width:220px;max-width:80%;margin-bottom:24px;}
#login-screen .sub{font-size:13px;color:#bbb;margin-bottom:28px;}
#login-screen input{width:100%;background:#f7f7f7;border:1px solid #eee;border-radius:10px;padding:14px;font-size:16px;outline:none;text-align:center;letter-spacing:2px;margin-bottom:12px;box-sizing:border-box;}
#login-screen input:focus{border-color:#5b9ab5;}
#login-screen .login-btn{width:100%;background:#5b9ab5;border:none;color:#fff;padding:14px;border-radius:10px;font-size:16px;font-weight:600;cursor:pointer;}
#login-screen .err{color:#c04040;font-size:13px;margin-top:8px;min-height:20px;}

/* Loading */
#loading-screen{position:fixed;inset:0;background:#fff;display:none;flex-direction:column;align-items:center;justify-content:center;z-index:100;gap:14px;}
.spin{width:36px;height:36px;border:3px solid #eee;border-top-color:#5b9ab5;border-radius:50%;animation:spin .8s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
#loading-screen p{font-size:14px;color:#bbb;}

/* Topbar */
.topbar{background:#fff;border-bottom:1px solid #e5e5e5;padding:12px 16px;position:sticky;top:0;z-index:20;}
.topbar-row{display:flex;align-items:center;justify-content:space-between;gap:10px;}
.topbar-title{font-size:17px;font-weight:700;cursor:pointer;}
.topbar-sub{font-size:11px;color:#bbb;margin-top:1px;}
.topbar-right{display:flex;align-items:center;gap:8px;flex-shrink:0;}
.sync{font-size:10px;color:#bbb;}
.sync.saving{color:#f0a000;}
.sync.ok{color:#5a9a5a;}
.sync.err{color:#c04040;}
.btn-primary{background:#5b9ab5;border:none;color:#fff;padding:7px 14px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;}
.btn-back{background:none;border:none;color:#5b9ab5;font-size:14px;font-weight:600;padding:0;cursor:pointer;}
.btn-secondary{background:#eef5f8;border:1px solid #c2dcea;color:#5b9ab5;padding:7px 14px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;}
.btn-danger{background:#fff5f5;border:1px solid #f0d0d0;color:#c87070;padding:7px 14px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;}

/* Search */
.search-wrap{position:relative;margin-top:10px;}
.search-input{width:100%;background:#f7f7f7;border:1px solid #eee;border-radius:8px;padding:9px 14px;font-size:14px;outline:none;}
.search-clear{position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;color:#bbb;font-size:18px;cursor:pointer;}

/* Navbar */
.navbar{background:#fff;border-bottom:1px solid #e5e5e5;padding:8px 12px;display:flex;align-items:center;gap:8px;position:sticky;top:105px;z-index:19;}
.nav-btn{background:none;border:1px solid #e5e5e5;border-radius:6px;padding:6px 12px;font-size:16px;color:#555;flex-shrink:0;cursor:pointer;}
.nav-selects{display:flex;gap:6px;flex:1;}
.nav-sel{background:#f7f7f7;border:1px solid #e5e5e5;border-radius:8px;padding:7px 10px;font-size:14px;font-weight:600;color:#1a1a1a;outline:none;-webkit-appearance:none;flex:1;text-align:center;}
.nav-sel-year{max-width:90px;}

/* Legend */
.legend{display:flex;gap:12px;flex-wrap:wrap;padding:8px 14px;background:#fff;border-bottom:1px solid #f0f0f0;}
.leg-item{display:flex;align-items:center;gap:5px;font-size:10px;color:#999;}
.leg-dot{width:8px;height:8px;border-radius:50%;}
.leg-box{width:12px;height:10px;border-radius:2px;background:#eef5f8;}

/* Day names */
.daynames{display:grid;grid-template-columns:repeat(7,1fr);background:#fff;padding:4px 8px 2px;position:sticky;top:153px;z-index:18;border-bottom:1px solid #f0f0f0;}
.dayname{text-align:center;font-size:10px;font-weight:700;color:#bbb;text-transform:uppercase;padding:4px 0;}
.dayname.sat{color:#5b9ab5;}

/* Calendar */
.calgrid{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;padding:6px 8px 100px;}
.cell{min-height:52px;border-radius:6px;padding:4px 2px;cursor:pointer;}
.cell:active{opacity:.7;}
.cell.other{opacity:.2;pointer-events:none;}
.cell.sat{background:#eef5f8;}
.cell.closed{background:#f0f0f0;}
.cell-num{text-align:center;font-size:13px;font-weight:500;line-height:22px;}
.cell-num.sat{color:#5b9ab5;font-weight:700;}
.cell-num.today-num{display:flex;justify-content:center;}
.today-circle{background:#5b9ab5;color:#fff;border-radius:50%;width:28px;height:28px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;margin:0 auto;}
.cell-dots{display:flex;flex-wrap:wrap;gap:2px;justify-content:center;margin-top:2px;}
.cell-dot{width:5px;height:5px;border-radius:50%;}
.cell-full{font-size:7px;color:#c87070;font-weight:700;text-transform:uppercase;text-align:center;margin-top:2px;}

/* Search results */
.sres{background:#fff;padding:12px 16px;border-bottom:1px solid #eee;display:none;}
.sres-hdr{font-size:10px;color:#5b9ab5;text-transform:uppercase;letter-spacing:1.5px;font-weight:700;margin-bottom:8px;}
.sres-row{padding:10px 0;border-bottom:1px solid #f5f5f5;cursor:pointer;}
.sres-name{font-size:15px;font-weight:500;}
.sres-sub{font-size:11px;color:#999;margin-top:2px;}

/* Day page */
.day-notice{background:#fef8ee;border:1px solid #f0ddb0;border-radius:8px;padding:10px 14px;margin:12px 14px;font-size:12px;color:#a07030;line-height:1.5;}
.closed-row{display:flex;align-items:center;justify-content:space-between;margin:12px 14px;padding:11px 14px;background:#fff;border-radius:10px;border:1px solid #eee;}
.closed-lbl{font-size:13px;color:#555;}

/* Wedding card */
.wcard{background:#fff;border-radius:10px;margin:8px 12px;overflow:hidden;border:1px solid #eee;}
.wcard-stripe{height:3px;}
.wcard-hdr{padding:13px 14px;display:flex;align-items:center;gap:10px;cursor:pointer;}
.wcard-name{font-size:16px;font-weight:500;}
.wcard-sub{font-size:11px;color:#bbb;margin-top:3px;}
.wcard-right{display:flex;align-items:center;gap:6px;flex-shrink:0;}
.wbadge{font-size:10px;padding:3px 10px;border-radius:20px;font-weight:600;white-space:nowrap;}
.warr{font-size:11px;color:#ddd;}

/* Card tabs */
.itabs{display:flex;overflow-x:auto;border-bottom:1px solid #eee;}
.itabs::-webkit-scrollbar{height:0;}
.itab{flex-shrink:0;padding:10px 13px;background:transparent;border:none;font-size:12px;color:#bbb;border-bottom:2px solid transparent;margin-bottom:-1px;font-weight:500;white-space:nowrap;cursor:pointer;}
.itab.on{color:#5b9ab5;font-weight:700;border-bottom-color:#5b9ab5;}

/* Tab content */
.tab-body{padding:14px 14px 20px;}
.sect-title{font-size:11px;font-weight:700;color:#bbb;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;}
.info-block{background:#f9f9f9;border-radius:8px;overflow:hidden;margin-bottom:12px;}
.info-row{display:flex;justify-content:space-between;align-items:flex-start;padding:9px 13px;border-bottom:1px solid #f0f0f0;}
.info-row:last-child{border-bottom:none;}
.info-lbl{font-size:12px;color:#bbb;flex-shrink:0;margin-right:12px;}
.info-val{font-size:13px;color:#1a1a1a;font-weight:500;text-align:right;flex:1;word-break:break-word;}
.info-val.em{color:#ccc;font-weight:400;font-style:italic;}
a.clink{display:flex;align-items:center;gap:10px;padding:11px 13px;background:#f9f9f9;border-radius:8px;margin-bottom:8px;text-decoration:none;border:1px solid #eee;}
.clink-lbl{font-size:11px;color:#bbb;font-weight:700;text-transform:uppercase;width:52px;flex-shrink:0;}
.clink-val{font-size:14px;color:#1a1a1a;font-weight:500;}
.map-row{display:flex;gap:8px;margin-top:10px;}
a.mapbtn{flex:1;text-decoration:none;padding:10px;border-radius:8px;font-size:13px;font-weight:600;text-align:center;display:block;}
a.mapbtn.blue{background:#eef5f8;color:#5b9ab5;border:1px solid #c2dcea;}
a.mapbtn.grn{background:#f0faf5;color:#5a8a5a;border:1px solid #b8d8c0;}
.pay-total{background:#1a1a1a;border-radius:10px;padding:16px;margin-bottom:14px;}
.pay-total-lbl{font-size:10px;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:6px;}
.pay-total-val{font-size:36px;font-weight:300;color:#fff;line-height:1;}
.pay-total-sub{font-size:12px;color:rgba(255,255,255,.5);margin-top:6px;}
.slot-row{display:flex;align-items:flex-start;gap:10px;padding:9px 12px;background:#f9f9f9;border-radius:7px;margin-bottom:6px;}
.slot-time{font-size:12px;font-weight:700;color:#5b9ab5;min-width:92px;flex-shrink:0;padding-top:2px;}
.slot-name{font-size:14px;font-weight:500;}
.slot-tags{display:flex;gap:4px;flex-wrap:wrap;margin-top:3px;}
.stag{font-size:10px;padding:2px 8px;border-radius:10px;}
.stag.sky{background:#eef5f8;color:#5b9ab5;}
.stag.gld{background:#fdf8f0;color:#b89c6e;}
.coif-blk{background:#fff;border:1px solid #eee;border-radius:10px;margin-bottom:10px;overflow:hidden;}
.coif-blk-hdr{display:flex;align-items:center;justify-content:space-between;padding:11px 13px;background:#f9f9f9;border-bottom:1px solid #eee;}
.coif-blk-name{font-size:14px;font-weight:600;}
.coif-blk-cnt{font-size:11px;color:#bbb;}
.coif-blk-body{padding:10px 13px;}
.tag-row{display:flex;flex-wrap:wrap;gap:6px;}
.tag{padding:6px 12px;border-radius:20px;border:1.5px solid #eee;background:#fff;font-size:12px;color:#999;cursor:pointer;}
.tag.sky{border-color:#5b9ab5;background:#eef5f8;color:#5b9ab5;font-weight:600;}
.tag.gld{border-color:#b89c6e;background:#fdf8f0;color:#b89c6e;font-weight:600;}
.pgrid{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;}
.pgrid img{width:80px;height:80px;object-fit:cover;border-radius:8px;border:1px solid #eee;}
.pwrap{position:relative;}
.pdel{position:absolute;top:-5px;right:-5px;background:#c87070;border:none;color:#fff;border-radius:50%;width:20px;height:20px;font-size:12px;font-weight:700;cursor:pointer;}
.empty{text-align:center;padding:28px 20px;color:#ccc;}
.empty p{font-size:14px;font-style:italic;}
.divider{height:1px;background:#f0f0f0;margin:14px 0;}
.act-row{display:flex;gap:8px;margin-top:14px;}
.act-row .btn-primary{flex:1;}

/* Form */
.form-topbar{background:#fff;border-bottom:1px solid #e5e5e5;padding:12px 16px;position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;}
.form-title{font-size:16px;font-weight:600;}
.ftabs{display:flex;overflow-x:auto;background:#fff;border-bottom:1px solid #e5e5e5;position:sticky;top:49px;z-index:19;}
.ftabs::-webkit-scrollbar{height:0;}
.ftab{flex-shrink:0;padding:10px 13px;background:transparent;border:none;font-size:12px;color:#bbb;border-bottom:2px solid transparent;margin-bottom:-1px;font-weight:500;white-space:nowrap;cursor:pointer;}
.ftab.on{color:#5b9ab5;font-weight:700;border-bottom-color:#5b9ab5;}
.form-body{padding:16px 16px 100px;}
.field{margin-bottom:16px;}
.field label{display:block;font-size:11px;font-weight:700;color:#bbb;text-transform:uppercase;letter-spacing:1px;margin-bottom:6px;}
.field input,.field select,.field textarea{width:100%;background:#fff;border:1px solid #e5e5e5;border-radius:8px;padding:11px 12px;font-size:15px;color:#1a1a1a;outline:none;box-sizing:border-box;-webkit-appearance:none;}
.field textarea{line-height:1.6;}
.field input:focus,.field select:focus,.field textarea:focus{border-color:#5b9ab5;}
.field .hint{font-size:11px;margin-top:4px;}
.row2{display:flex;gap:10px;}
.row2 .field{flex:1;}
.choices{display:flex;gap:8px;}
.choice{flex:1;padding:9px 6px;border:1.5px solid #eee;border-radius:8px;background:#fff;color:#999;font-size:12px;text-align:center;cursor:pointer;}
.choice.on{border-color:#5b9ab5;background:#eef5f8;color:#5b9ab5;font-weight:600;}
.check-row{display:flex;align-items:center;gap:10px;padding:11px 13px;background:#fff;border:1px solid #e5e5e5;border-radius:8px;margin-bottom:14px;cursor:pointer;}
.check-row input[type=checkbox]{width:20px;height:20px;accent-color:#5b9ab5;flex-shrink:0;}
.check-row span{font-size:14px;color:#333;}
.inv-row{display:flex;gap:8px;}
.inv-choice{flex:1;padding:10px 8px;border:1.5px solid #eee;border-radius:8px;background:#fff;text-align:center;cursor:pointer;}
.inv-choice.on{border-color:#5b9ab5;background:#eef5f8;}
.inv-choice-lbl{font-size:13px;color:#1a1a1a;}
.inv-choice.on .inv-choice-lbl{color:#5b9ab5;font-weight:600;}
.inv-choice-sub{font-size:10px;color:#bbb;margin-top:2px;}
.coif-form-blk{background:#fff;border:1px solid #e5e5e5;border-radius:10px;margin-bottom:12px;overflow:hidden;}
.coif-form-hdr{display:flex;align-items:center;justify-content:space-between;padding:11px 13px;background:#f9f9f9;border-bottom:1px solid #eee;}
.coif-name-inp{border:none;background:transparent;font-size:15px;color:#1a1a1a;font-weight:600;outline:none;font-family:inherit;flex:1;min-width:0;}
.coif-form-body{padding:10px 13px;}
.client-row{display:flex;align-items:center;gap:6px;margin-bottom:6px;padding:8px 10px;background:#f9f9f9;border-radius:8px;flex-wrap:wrap;}
.client-time-inp{border:none;background:transparent;font-size:11px;font-weight:700;color:#5b9ab5;width:54px;outline:none;font-family:inherit;padding:0;}
.client-dur-inp{border:none;background:#eef5f8;border-radius:4px;font-size:10px;color:#5b9ab5;width:34px;text-align:center;outline:none;padding:2px 3px;}
.client-dur-lbl{font-size:10px;color:#bbb;flex-shrink:0;}
.client-end-lbl{font-size:10px;color:#aaa;flex-shrink:0;white-space:nowrap;}
.client-inp{border:none;background:transparent;flex:1;outline:none;font-size:14px;font-family:inherit;color:#1a1a1a;min-width:60px;}
.client-del{background:none;border:none;color:#c87070;font-size:18px;cursor:pointer;padding:0 2px;flex-shrink:0;}
.style-sel{width:100%;background:#fff;border:1px solid #eee;border-radius:6px;padding:7px 10px;font-size:12px;outline:none;margin-bottom:6px;color:#555;}
.orient-btn{padding:4px 10px;border-radius:20px;border:1px solid #eee;background:#fff;font-size:11px;color:#999;cursor:pointer;}
.orient-btn.on{border-color:#b89c6e;background:#fdf8f0;color:#b89c6e;font-weight:600;}
.fin-box{background:#f9f9f9;border:1px solid #eee;border-radius:8px;padding:11px 13px;margin-top:10px;}
.err-banner{background:#fff0f0;border:1px solid #f0c0c0;color:#c04040;padding:10px 14px;font-size:12px;margin:0 16px 10px;border-radius:8px;display:none;}

/* Status colors */
.s-confirme{background:#8aab8c;}.s-complet{background:#c8a0a0;}.s-equipe1{background:#9b7fc4;}.s-equipe2{background:#c87090;}.s-equipe3{background:#5b9ab5;}.s-pending{background:#c8b89a;}
.b-confirme{background:#f0f7f0;color:#5a8a5a;border:1px solid #c0d8c0;}
.b-complet{background:#fff5f5;color:#c8a0a0;border:1px solid #f0d0d0;}
.b-equipe1{background:#f5f0fb;color:#7050a0;border:1px solid #d0b8f0;}
.b-equipe2{background:#fff0f5;color:#c05070;border:1px solid #f0b8c8;}
.b-equipe3{background:#eef5f8;color:#5b9ab5;border:1px solid #c2dcea;}
.b-pending{background:#fdf8f0;color:#b89060;border:1px solid #e8d8b0;}

.toast{position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:#333;color:#fff;padding:10px 20px;border-radius:20px;font-size:13px;z-index:999;pointer-events:none;white-space:nowrap;max-width:90vw;}
</style>
</head>
<body>

<div id="login-screen">
  <img src="data:image/jpeg;base64," alt="Les Cheveux de la Mariée"/>
  <div class="sub">Accès réservé</div>
  <input type="password" id="pwd-input" placeholder="Mot de passe" onkeydown="if(event.key==='Enter')checkPwd()"/>
  <button class="login-btn" onclick="checkPwd()">Accéder</button>
  <div class="err" id="login-err"></div>
</div>

<div id="loading-screen">
  <div class="spin"></div>
  <p>Chargement…</p>
</div>

<div id="page-cal" class="page">
  <div class="topbar">
    <div class="topbar-row">
      <div>
        <div class="topbar-title" onclick="goToToday()">Planning Mariages</div>
        <div class="topbar-sub">Appuyez sur une date</div>
      </div>
      <div class="topbar-right">
        <span class="sync" id="sync-lbl">—</span>
        <button class="btn-primary" onclick="openNewWedding()">+ Nouveau</button>
      </div>
    </div>
    <div class="search-wrap">
      <input class="search-input" type="text" id="search-inp" placeholder="Rechercher…" oninput="doSearch(this.value)"/>
      <button class="search-clear" id="search-clear" style="display:none" onclick="clearSearch()">×</button>
    </div>
  </div>
  <div class="sres" id="sres-box"></div>
  <div class="navbar">
    <button class="nav-btn" onclick="prevMonth()">‹</button>
    <div class="nav-selects">
      <select class="nav-sel" id="sel-month" onchange="setMonth(this.value)"></select>
      <select class="nav-sel nav-sel-year" id="sel-year" onchange="setYear(this.value)"></select>
    </div>
    <button class="nav-btn" onclick="nextMonth()">›</button>
  </div>
  <div class="legend">
    <div class="leg-item"><div class="leg-box"></div><span>Samedi</span></div>
    <div class="leg-item"><div class="leg-dot s-confirme"></div><span>Confirmé</span></div>
    <div class="leg-item"><div class="leg-dot s-complet"></div><span>Complet</span></div>
    <div class="leg-item"><div class="leg-dot s-pending"></div><span>À confirmer</span></div>
  </div>
  <div class="daynames" id="daynames"></div>
  <div class="calgrid" id="calgrid"></div>
</div>

<div id="page-day" class="page">
  <div class="topbar">
    <div class="topbar-row">
      <button class="btn-back" onclick="showPage('cal')">← Retour</button>
      <div class="topbar-title" id="day-title"></div>
      <button class="btn-primary" onclick="openNewWeddingOnDate()">+ Ajouter</button>
    </div>
  </div>
  <div id="day-body"></div>
</div>

<div id="page-form" class="page">
  <div class="form-topbar">
    <button class="btn-back" onclick="cancelForm()">← Annuler</button>
    <span class="form-title" id="form-title">Nouveau mariage</span>
    <button class="btn-primary" onclick="saveWedding()">Enregistrer</button>
  </div>
  <div class="ftabs" id="ftabs"></div>
  <div class="err-banner" id="form-err"></div>
  <div class="form-body" id="form-body"></div>
</div>

<script>
// ══ CONFIG ══════════════════════════════════════════════
const SUPA_URL = "https://ccnpfmlpbmtnygbprmif.supabase.co";
const SUPA_KEY = "sb_publishable_0oSish2LrU23kGRkXx-SiA_sAukjkIa";
const TABLE    = "weddings";
const APP_PASSWORD = "LM2027";
const AUTH_KEY = "lm-auth-v2";

// ══ SUPABASE ════════════════════════════════════════════
function supaFetch(method, path, body) {
  return new Promise(function(resolve, reject) {
    var xhr = new XMLHttpRequest();
    xhr.open(method, SUPA_URL + "/rest/v1/" + path, true);
    xhr.setRequestHeader("apikey", SUPA_KEY);
    xhr.setRequestHeader("Authorization", "Bearer " + SUPA_KEY);
    xhr.setRequestHeader("Content-Type", "application/json");
    xhr.setRequestHeader("Accept", "application/json");
    if (method === "POST") xhr.setRequestHeader("Prefer", "resolution=merge-duplicates,return=minimal");
    xhr.onload = function() {
      if (xhr.status >= 200 && xhr.status < 300) {
        if (method === "GET" && xhr.responseText) {
          try { resolve(JSON.parse(xhr.responseText)); }
          catch(e) { reject(new Error("JSON parse error: " + xhr.responseText)); }
        } else { resolve(null); }
      } else {
        reject(new Error("Supabase " + method + " " + xhr.status + ": " + xhr.responseText));
      }
    };
    xhr.onerror = function() { reject(new Error("Erreur réseau — vérifiez votre connexion")); };
    xhr.ontimeout = function() { reject(new Error("Délai dépassé — Supabase ne répond pas")); };
    xhr.timeout = 20000;
    xhr.send(body ? JSON.stringify(body) : null);
  });
}
async function dbGetAll() { return supaFetch("GET", TABLE + "?select=id,date,data->status"); }
async function dbGetOne(id)      { return supaFetch("GET", TABLE + "?select=id,date,data&id=eq." + encodeURIComponent(id)); }
async function dbUpsert(w)       { return supaFetch("POST", TABLE, {id:w.id,date:w.date,data:w}); }
async function dbDelete(id)      { return supaFetch("DELETE", TABLE + "?id=eq." + encodeURIComponent(id)); }
async function dbUpsertMeta(k,v) { return supaFetch("POST", TABLE, {id:"__meta_"+k,date:"meta",data:{value:v}}); }

// ══ CONSTANTS ═══════════════════════════════════════════
const MONTHS = ["Janvier","Février","Mars","Avril","Mai","Juin","Juillet","Août","Septembre","Octobre","Novembre","Décembre"];
const DAYS   = ["Lun","Mar","Mer","Jeu","Ven","Sam","Dim"];
const STYLES = ["Chignon haut","Chignon bas","French twist","Demi-attache","Tresses","Brushing","Queue de cheval"];
const ORIENTS= ["Classique chic","Structuré","Lisser","Plaquer","Bohème","Lâche","Flou"];
const SL     = {confirme:"Confirmé",complet:"Complet",equipe1:"Équipe 1",equipe2:"Équipe 2",equipe3:"Équipe 3",pending:"À confirmer"};
const SC     = {confirme:"#8aab8c",complet:"#c8a0a0",equipe1:"#9b7fc4",equipe2:"#c87090",equipe3:"#5b9ab5",pending:"#c8b89a"};
const TODAY  = new Date();
const CUR_YEAR = TODAY.getFullYear();
const YEARS  = Array.from({length:7},(_,i)=>CUR_YEAR+i);

// ══ STATE ═══════════════════════════════════════════════
var WEDDINGS = [];
var CLOSED_DATES = [];
var CAL = {year:CUR_YEAR, month:TODAY.getMonth()};
var SEL_DATE = null;
var FORM = null;
var FORM_TAB = "info";
var EXP_CARD = null;
var CARD_TAB = {};

// ══ HELPERS ═════════════════════════════════════════════
function uid() { return Date.now().toString(36) + Math.random().toString(36).slice(2,6); }
function isoDate(y,m,d) { return y+"-"+String(m+1).padStart(2,"0")+"-"+String(d).padStart(2,"0"); }
function isSat(iso) { return new Date(iso+"T12:00:00").getDay()===6; }
function fmtDate(iso) {
  var parts = iso.split("-");
  var dt = new Date(iso+"T12:00:00");
  var DN = ["Dimanche","Lundi","Mardi","Mercredi","Jeudi","Vendredi","Samedi"];
  return {day:parseInt(parts[2]),month:MONTHS[parseInt(parts[1])-1],year:parts[0],dayName:DN[dt.getDay()],sat:dt.getDay()===6};
}
function addMin(t,min) {
  if (!t) return "";
  var parts = t.split(":").map(Number);
  var tot = parts[0]*60+parts[1]+min;
  return String(Math.floor(tot/60)%24).padStart(2,"0")+":"+String(tot%60).padStart(2,"0");
}
function emptyW(date) {
  return {
    id:uid(), date:date||isoDate(CUR_YEAR,TODAY.getMonth(),TODAY.getDate()),
    names:"", phone:"", email:"", publicationOk:null, status:"pending",
    location:"", arrivalTime:"", departureTime:"", forfait:"", nbInvites:"",
    payment:{forfait:"",km:"",prixKm:"1",acompteAmount:"",acompteDate:"",acompteReceived:false,invitesMode:"mariee"},
    vendors:{weddingPlanner:"",photographe:"",videaste:"",fleuriste:"",mua:"",robe:"",costume:"",autres:""},
    coiffeuses:[],
    notesTab:{stylePresets:[],orientationPresets:[],voile:null,voilePose:"",accessoires:null,accessoiresList:[],heureMaquillage:"",photos:[],notes:""},
    contrat:[]
  };
}
function wByDate() {
  var m = {};
  WEDDINGS.forEach(function(w){ if(!m[w.date])m[w.date]=[]; m[w.date].push(w); });
  return m;
}
function showToast(msg) {
  var t = document.querySelector(".toast"); if(t)t.remove();
  t = document.createElement("div"); t.className="toast"; t.textContent=msg;
  document.body.appendChild(t); setTimeout(function(){t.remove();},2400);
}
function setSyncLabel(text,cls) {
  var e = document.getElementById("sync-lbl"); if(!e)return;
  e.textContent=text; e.className="sync "+(cls||"");
}
function showFormError(msg) {
  var e = document.getElementById("form-err"); if(!e)return;
  if(msg){e.textContent=msg;e.style.display="block";}else e.style.display="none";
}
function mkEl(tag,cls,style) {
  var e=document.createElement(tag);
  if(cls)e.className=cls;
  if(style)Object.assign(e.style,style);
  return e;
}
function mkDiv(cls,style){return mkEl("div",cls,style);}
function mkBtn(cls,text,fn){
  var b=document.createElement("button");
  b.className=cls; b.textContent=text;
  if(fn)b.addEventListener("click",fn);
  return b;
}

// ══ AUTH ════════════════════════════════════════════════
function checkPwd() {
  var val = document.getElementById("pwd-input").value;
  var err = document.getElementById("login-err");
  if (val === APP_PASSWORD) {
    sessionStorage.setItem(AUTH_KEY,"1");
    document.getElementById("login-screen").style.display = "none";
    document.getElementById("loading-screen").style.display = "flex";
    loadAll();
  } else {
    err.textContent = "Mot de passe incorrect";
    document.getElementById("pwd-input").value = "";
    document.getElementById("pwd-input").focus();
    setTimeout(function(){err.textContent="";},2500);
  }
}

// ══ LOAD ════════════════════════════════════════════════
async function loadAll(retry) {
  try {
    var rows = await dbGetAll();
    WEDDINGS = [];
    CLOSED_DATES = [];
    rows.forEach(function(row) {
      if (row.id.startsWith("__meta_closedDates")) {
        CLOSED_DATES = (row.data && row.data.value) ? row.data.value : [];
      } else if (!row.id.startsWith("__meta_")) {
        WEDDINGS.push({ id: row.id, date: row.date, status: row.status || "pending", _loaded: false });
      }
    });
    document.getElementById("loading-screen").style.display = "none";
    showPage("cal");
    buildCal();
    setSyncLabel("✓ Synchronisé","ok");
  } catch(err) {
    console.error("Supabase error:", err);
    // Retry automatique une fois (cold start Supabase)
    if (!retry) {
      setSyncLabel("Reconnexion…","saving");
      setTimeout(function(){ loadAll(true); }, 3000);
      return;
    }
    document.getElementById("loading-screen").style.display = "none";
    showPage("cal");
    buildCal();
    setSyncLabel("⚠ Hors ligne","err");
    showToast("Erreur : " + err.message.substring(0, 60));
  }
}

// Charge les données complètes d'un mariage à la demande
async function loadWeddingData(id) {
  var existing = WEDDINGS.find(function(x){ return x.id === id; });
  if (existing && existing._loaded) return existing; // déjà chargé
  try {
    var rows = await dbGetOne(id);
    if (rows && rows.length) {
      var w = (typeof rows[0].data === "object") ? rows[0].data : JSON.parse(rows[0].data);
      w._loaded = true;
      WEDDINGS = WEDDINGS.map(function(x){ return x.id === id ? w : x; });
      return w;
    }
  } catch(e) {
    console.error("Erreur chargement fiche:", e);
    showToast("Erreur chargement fiche");
  }
  return existing;
}
async function persistW(w) {
  setSyncLabel("Sauvegarde…","saving");
  try { await dbUpsert(w); setSyncLabel("✓ Sauvegardé","ok"); }
  catch(e) { setSyncLabel("⚠ Erreur","err"); showToast("Erreur de sauvegarde"); throw e; }
}
async function deleteW(id) {
  try { await dbDelete(id); }
  catch(e) { showToast("Erreur suppression"); }
}

// ══ PAGES ═══════════════════════════════════════════════
function showPage(id) {
  document.querySelectorAll(".page").forEach(function(p){p.classList.remove("active");});
  var p = document.getElementById("page-"+id);
  if(p){p.classList.add("active");p.scrollTop=0;}
}
function goToToday() { CAL.year=TODAY.getFullYear(); CAL.month=TODAY.getMonth(); buildCal(); showPage("cal"); }

// ══ CALENDAR ════════════════════════════════════════════
function initNavSelects() {
  var ms=document.getElementById("sel-month"), ys=document.getElementById("sel-year");
  if(!ms.options.length){
    MONTHS.forEach(function(m,i){ms.appendChild(new Option(m,i));});
    YEARS.forEach(function(y){ys.appendChild(new Option(y,y));});
  }
  ms.value=String(CAL.month); ys.value=String(CAL.year);
}
function setMonth(v){CAL.month=parseInt(v);buildCal();}
function setYear(v){CAL.year=parseInt(v);buildCal();}
function prevMonth(){if(CAL.month===0){CAL.month=11;CAL.year=Math.max(YEARS[0],CAL.year-1);}else CAL.month--;buildCal();}
function nextMonth(){if(CAL.month===11){CAL.month=0;CAL.year=Math.min(YEARS[YEARS.length-1],CAL.year+1);}else CAL.month++;buildCal();}

function buildCal() {
  initNavSelects();
  var dn=document.getElementById("daynames"); dn.innerHTML="";
  DAYS.forEach(function(d,i){var e=mkDiv("dayname"+(i===5?" sat":""));e.textContent=d;dn.appendChild(e);});
  var grid=document.getElementById("calgrid"); grid.innerHTML="";
  var y=CAL.year,m=CAL.month;
  var first=new Date(y,m,1);
  var off=first.getDay()-1; if(off<0)off=6;
  var dim=new Date(y,m+1,0).getDate();
  var prev=new Date(y,m,0).getDate();
  var wbd=wByDate();
  var cells=[];
  for(var i=off-1;i>=0;i--)cells.push({d:prev-i,mo:m-1,yo:y,other:true});
  for(var d=1;d<=dim;d++)cells.push({d:d,mo:m,yo:y,other:false});
  while(cells.length%7!==0)cells.push({d:cells.length-off-dim+1,mo:m+1,yo:y,other:true});
  cells.forEach(function(c){
    var nm=c.mo,ny=c.yo;
    if(nm<0){nm=11;ny--;} if(nm>11){nm=0;ny++;}
    var iso=isoDate(ny,nm,c.d);
    var sat=isSat(iso);
    var closed=CLOSED_DATES.indexOf(iso)>=0;
    var ws=wbd[iso]||[];
    var isToday=!c.other&&TODAY.getFullYear()===ny&&TODAY.getMonth()===nm&&TODAY.getDate()===c.d;
    var cls="cell"+(c.other?" other":(sat?" sat":"")+(closed?" closed":""));
    var cell=mkDiv(cls);
    var num=mkDiv("cell-num"+(sat&&!c.other?" sat":""));
    if(isToday){
      num.className="cell-num today-num";
      var inner=mkDiv("today-circle");
      inner.textContent=c.d;
      num.appendChild(inner);
    } else {
      num.textContent=c.d;
    }
    cell.appendChild(num);
    if(!c.other){
      var full=ws.some(function(w){return w.status==="complet";});
      if(full){var fl=mkDiv("cell-full");fl.textContent="Complet";cell.appendChild(fl);}
      else if(ws.length){var dots=mkDiv("cell-dots");ws.forEach(function(w){var dot=mkDiv("cell-dot");dot.style.background=SC[w.status]||"#ccc";dots.appendChild(dot);});cell.appendChild(dots);}
      (function(iso2){cell.addEventListener("click",function(){openDay(iso2);});})(iso);
    }
    grid.appendChild(cell);
  });

  // Swipe : un seul changement de mois par geste
  var swipeStartX=0, swipeStartY=0, swipeLocked=false;
  grid.addEventListener("touchstart",function(e){
    swipeStartX=e.touches[0].clientX;
    swipeStartY=e.touches[0].clientY;
    swipeLocked=false;
  },{passive:true});
  grid.addEventListener("touchmove",function(e){
    if(swipeLocked)return;
    var dx=e.touches[0].clientX-swipeStartX;
    var dy=e.touches[0].clientY-swipeStartY;
    if(Math.abs(dx)>Math.abs(dy)&&Math.abs(dx)>60){
      swipeLocked=true; // verrouille dès qu'on détecte le swipe, empêche tout autre déclenchement
      if(dx<0){
        // Doigt vers la gauche = avancer d'un mois
        if(CAL.month===11){CAL.month=0;CAL.year=Math.min(YEARS[YEARS.length-1],CAL.year+1);}
        else CAL.month++;
      } else {
        // Doigt vers la droite = reculer d'un mois
        if(CAL.month===0){CAL.month=11;CAL.year=Math.max(YEARS[0],CAL.year-1);}
        else CAL.month--;
      }
      buildCal();
    }
  },{passive:true});
}

// ══ SEARCH ══════════════════════════════════════════════
function doSearch(q) {
  document.getElementById("search-clear").style.display=q?"":"none";
  var box=document.getElementById("sres-box");
  if(!q||q.length<2){box.style.display="none";return;}
  var ql=q.toLowerCase();
  var res=WEDDINGS.filter(function(w){return[w.names,w.location,w.phone,w.email].some(function(f){return(f||"").toLowerCase().indexOf(ql)>=0;});});
  box.style.display="block"; box.innerHTML="";
  var hdr=mkDiv("sres-hdr");hdr.textContent=res.length+" résultat"+(res.length!==1?"s":"");box.appendChild(hdr);
  if(!res.length){var e=mkDiv("");e.style.cssText="color:#ccc;font-style:italic;font-size:13px;";e.textContent="Aucun résultat";box.appendChild(e);return;}
  res.forEach(function(w){
    var fd=fmtDate(w.date);
    var row=mkDiv("sres-row");
    var n=mkDiv("sres-name");n.textContent=w.names||"Sans nom";
    var s=mkDiv("sres-sub");s.textContent=fd.dayName+" "+fd.day+" "+fd.month+" "+fd.year+(w.location?" · "+w.location:"");
    row.appendChild(n);row.appendChild(s);
    (function(w2){row.addEventListener("click",function(){CAL.year=parseInt(w2.date.split("-")[0]);CAL.month=parseInt(w2.date.split("-")[1])-1;clearSearch();openDay(w2.date);});})(w);
    box.appendChild(row);
  });
}
function clearSearch(){
  document.getElementById("search-inp").value="";
  document.getElementById("search-clear").style.display="none";
  document.getElementById("sres-box").style.display="none";
}

// ══ DAY PAGE ════════════════════════════════════════════
function openDay(iso) {
  SEL_DATE=iso;
  var fd=fmtDate(iso);
  document.getElementById("day-title").textContent=fd.dayName+" "+fd.day+" "+fd.month;
  // Charge les données complètes de tous les mariages de cette date
  var ws=(wByDate()[iso]||[]);
  var toLoad=ws.filter(function(w){return !w._loaded;});
  if(toLoad.length===0){
    buildDayPage();showPage("day");
  } else {
    showPage("day");
    document.getElementById("day-body").innerHTML='<div style="text-align:center;padding:40px;color:#bbb;">Chargement…</div>';
    Promise.all(toLoad.map(function(w){return loadWeddingData(w.id);}))
      .then(function(){buildDayPage();})
      .catch(function(){buildDayPage();});
  }
}
function buildDayPage() {
  var iso=SEL_DATE;
  var body=document.getElementById("day-body"); body.innerHTML="";
  var fd=fmtDate(iso);
  var ws=(wByDate()[iso]||[]);
  var isClosed=CLOSED_DATES.indexOf(iso)>=0;
  if(!fd.sat){var n=mkDiv("day-notice");n.textContent="Ce jour n'est pas un samedi. Vous pouvez tout de même y ajouter un mariage.";body.appendChild(n);}
  var cr=mkDiv("closed-row");
  var cl=mkDiv("closed-lbl");cl.textContent="Date fermée";
  var tb=mkBtn("btn-"+(isClosed?"primary":"secondary"),isClosed?"Fermée":"Ouverte",function(){
    if(isClosed)CLOSED_DATES=CLOSED_DATES.filter(function(x){return x!==iso;});
    else CLOSED_DATES.push(iso);
    dbUpsertMeta("closedDates",CLOSED_DATES);
    buildDayPage();buildCal();
  });
  tb.style.cssText="padding:5px 14px;font-size:12px;";
  cr.appendChild(cl);cr.appendChild(tb);body.appendChild(cr);
  if(!ws.length&&!isClosed){var em=mkDiv("empty");em.innerHTML="<p>Aucun mariage — appuyez sur + Ajouter</p>";body.appendChild(em);}
  ws.forEach(function(w){body.appendChild(buildWCard(w));});
}

// ══ WEDDING CARD ════════════════════════════════════════
function buildWCard(w) {
  var cid=w.id, isExp=EXP_CARD===cid, itab=CARD_TAB[cid]||"details";
  var card=mkDiv("wcard");
  var stripe=mkDiv("wcard-stripe");stripe.style.background=SC[w.status]||"#ccc";card.appendChild(stripe);
  var hdr=mkDiv("wcard-hdr");
  var info=mkDiv("");info.style.cssText="flex:1;min-width:0;";
  var nm=mkDiv("wcard-name");nm.textContent=w.names||"Sans nom";info.appendChild(nm);
  var subs=[w.location,w.arrivalTime].filter(Boolean).join(" · ");
  if(subs){var s=mkDiv("wcard-sub");s.textContent=subs;info.appendChild(s);}
  hdr.appendChild(info);
  var right=mkDiv("wcard-right");
  var badge=mkDiv("wbadge b-"+(w.status||"pending"));badge.textContent=SL[w.status]||w.status;
  var arr=mkDiv("warr");arr.textContent=isExp?"▲":"▼";
  right.appendChild(badge);right.appendChild(arr);hdr.appendChild(right);
  (function(cid2,isExp2){hdr.addEventListener("click",function(){EXP_CARD=isExp2?null:cid2;buildDayPage();});})(cid,isExp);
  card.appendChild(hdr);
  if(!isExp)return card;
  var TABS=[["details","Détails"],["maps","Lieu"],["payment","Paiement"],["planning","Planning"],["notes","Notes"],["vendors","Prestataires"],["contrat","Contrat"]];
  var bar=mkDiv("itabs");
  TABS.forEach(function(t){
    var b=mkBtn("itab"+(itab===t[0]?" on":""),t[1],null);
    (function(tid){b.addEventListener("click",function(){CARD_TAB[cid]=tid;buildDayPage();});})(t[0]);
    bar.appendChild(b);
  });
  card.appendChild(bar);
  var body=mkDiv("tab-body");
  if(itab==="details")body.appendChild(tabDetails(w));
  else if(itab==="maps")body.appendChild(tabMaps(w));
  else if(itab==="payment")body.appendChild(tabPayment(w));
  else if(itab==="planning")body.appendChild(tabPlanning(w));
  else if(itab==="notes")body.appendChild(tabNotes(w));
  else if(itab==="vendors")body.appendChild(tabVendors(w));
  else if(itab==="contrat")body.appendChild(tabContrat(w));
  card.appendChild(body);
  return card;
}

function mkInfoBlock(rows) {
  var ib=mkDiv("info-block");
  rows.forEach(function(r){
    var row=mkDiv("info-row");
    var l=mkDiv("info-lbl");l.textContent=r[0];
    var v=mkDiv("info-val"+((!r[1]||r[1]==="—")?" em":""));v.textContent=r[1]||"—";
    row.appendChild(l);row.appendChild(v);ib.appendChild(row);
  });
  return ib;
}
function mkDivider(){return mkDiv("divider");}

function tabDetails(w) {
  var b=mkDiv("");
  b.appendChild(mkDiv("sect-title",null,{fontSize:"11px",fontWeight:"700",color:"#bbb",textTransform:"uppercase",letterSpacing:"1px",marginBottom:"8px"}));
  b.lastChild.textContent="Contact";
  if(w.phone){var a=document.createElement("a");a.href="tel:"+w.phone;a.className="clink";a.innerHTML='<span class="clink-lbl">Tél</span><span class="clink-val">'+w.phone+'</span>';b.appendChild(a);}
  if(w.email){var a2=document.createElement("a");a2.href="mailto:"+w.email;a2.className="clink";a2.innerHTML='<span class="clink-lbl">Email</span><span class="clink-val">'+w.email+'</span>';b.appendChild(a2);}
  if(!w.phone&&!w.email){var e=mkDiv("");e.style.cssText="color:#ccc;font-style:italic;font-size:13px;margin-bottom:10px;";e.textContent="Aucun contact";b.appendChild(e);}
  b.appendChild(mkDivider());
  b.appendChild(mkInfoBlock([["Statut",SL[w.status]||w.status],["Forfait",w.forfait||"—"],["Invités",w.nbInvites||"—"],["Arrivée",w.arrivalTime||"—"],["Départ",w.departureTime||"—"],["Publication",w.publicationOk===true?"Autorisée":w.publicationOk===false?"Refusée":"Non répondu"]]));
  b.appendChild(mkDivider());
  var acts=mkDiv("act-row");
  var be=mkBtn("btn-primary","Modifier",function(){openEditWedding(w);});
  var bd=mkBtn("btn-danger","Supprimer",function(){
    if(!confirm("Supprimer "+w.names+" ?"))return;
    WEDDINGS=WEDDINGS.filter(function(x){return x.id!==w.id;});
    deleteW(w.id);buildDayPage();buildCal();showToast("Supprimé");
  });
  acts.appendChild(be);acts.appendChild(bd);b.appendChild(acts);
  return b;
}

function tabMaps(w) {
  var b=mkDiv("");
  if(!w.location){var em=mkDiv("empty");em.innerHTML="<p>Aucun lieu renseigné</p>";b.appendChild(em);return b;}
  b.appendChild(mkInfoBlock([["Lieu",w.location]]));
  var mr=mkDiv("map-row");
  var a1=document.createElement("a");a1.href="https://www.google.com/maps/search/?api=1&query="+encodeURIComponent(w.location);a1.target="_blank";a1.className="mapbtn blue";a1.textContent="Voir sur Maps";
  var a2=document.createElement("a");a2.href="https://waze.com/ul?q="+encodeURIComponent(w.location)+"&navigate=yes";a2.target="_blank";a2.className="mapbtn grn";a2.textContent="Waze";
  mr.appendChild(a1);mr.appendChild(a2);b.appendChild(mr);
  return b;
}

function tabPayment(w) {
  var pay=w.payment||{};
  var f=parseFloat(pay.forfait)||0,km=parseFloat(pay.km)||0,pk=parseFloat(pay.prixKm)||1;
  var frais=km*pk,total=f+frais,ac=parseFloat(pay.acompteAmount)||0,reste=Math.max(0,total-ac);
  var b=mkDiv("");
  var tc=mkDiv("pay-total");
  tc.innerHTML='<div class="pay-total-lbl">Total à payer</div><div class="pay-total-val">'+(total>0?total.toFixed(2)+" €":"—")+'</div>';
  if(ac>0){var ts=mkDiv("pay-total-sub");ts.innerHTML="Acompte : "+ac.toFixed(2)+" € → <span style='color:"+(reste===0?"#7fd87f":"#ffcc70")+";font-weight:600'>"+(reste===0?"Soldé":"Reste "+reste.toFixed(2)+" €")+"</span>";tc.appendChild(ts);}
  b.appendChild(tc);
  b.appendChild(mkInfoBlock([["Forfait",pay.forfait?pay.forfait+" €":"—"],["Km",pay.km?pay.km+" km":"—"],["Prix/km",(pay.prixKm||"1")+" €/km"],["Acompte",pay.acompteAmount?pay.acompteAmount+" €":"—"],["Acompte reçu",pay.acompteReceived?"Oui":"Non"],["Invités",pay.invitesMode==="mariee"?"Par la mariée":"Individuel"]]));
  b.appendChild(mkBtn("btn-secondary",function(){return "Modifier le paiement";}(),function(){openEditWedding(w,"payment");}));
  b.lastChild.style.width="100%";b.lastChild.style.marginTop="4px";
  return b;
}

function tabPlanning(w) {
  var b=mkDiv("");
  b.appendChild(mkInfoBlock([["Arrivée",w.arrivalTime||"—"],["Départ",w.departureTime||"—"]]));
  var coifs=w.coiffeuses||[];
  if(!coifs.length){var em=mkDiv("empty");em.innerHTML="<p>Aucun planning</p>";b.appendChild(em);}
  else coifs.forEach(function(cf,ci){
    var blk=mkDiv("coif-blk");
    var bh=mkDiv("coif-blk-hdr");
    var dot=mkEl("span","");dot.style.cssText="display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:8px;background:"+["#9b7fc4","#c87090","#5b9ab5","#8aab8c"][ci||0]+";";
    var nm=mkDiv("coif-blk-name");nm.textContent=cf.name||"Coiffeuse "+(ci+1);
    var cnt=mkDiv("coif-blk-cnt");cnt.textContent=(cf.clients||[]).length+" cliente"+(cf.clients&&cf.clients.length>1?"s":"");
    var hn=mkDiv("");hn.style.cssText="display:flex;align-items:center;";hn.appendChild(dot);hn.appendChild(nm);
    bh.appendChild(hn);bh.appendChild(cnt);blk.appendChild(bh);
    if((cf.clients||[]).length){
      var bb=mkDiv("coif-blk-body");
      cf.clients.forEach(function(cl,idx){
        var dur=parseInt(cl.duration)||45;
        var st=cl.startTime||addMin(w.arrivalTime||"08:00",idx*45);
        var en=addMin(st,dur);
        var row=mkDiv("slot-row");
        var time=mkDiv("slot-time");time.textContent=st+" → "+en;
        var iinfo=mkDiv("");
        var sn=mkDiv("slot-name");sn.textContent=cl.person||"—";iinfo.appendChild(sn);
        if(cl.style){var tags=mkDiv("slot-tags");var t=mkDiv("stag sky");t.textContent=cl.style;tags.appendChild(t);iinfo.appendChild(tags);}
        row.appendChild(time);row.appendChild(iinfo);bb.appendChild(row);
      });
      blk.appendChild(bb);
    }
    b.appendChild(blk);
  });
  var eb=mkBtn("btn-secondary","Modifier le planning",function(){openEditWedding(w,"planning");});
  eb.style.cssText="width:100%;margin-top:8px;";b.appendChild(eb);
  return b;
}

function tabNotes(w) {
  var nt=w.notesTab||{},b=mkDiv("");
  if((nt.stylePresets||[]).length||(nt.orientationPresets||[]).length){
    var st=mkDiv("sect-title",null,{fontSize:"11px",fontWeight:"700",color:"#bbb",textTransform:"uppercase",letterSpacing:"1px",marginBottom:"8px"});st.textContent="Style retenu";b.appendChild(st);
    var tr=mkDiv("tag-row");
    (nt.stylePresets||[]).forEach(function(s){var t=mkDiv("stag sky");t.textContent=s;tr.appendChild(t);});
    (nt.orientationPresets||[]).forEach(function(s){var t=mkDiv("stag gld");t.textContent=s;tr.appendChild(t);});
    b.appendChild(tr);b.appendChild(mkDivider());
  }
  var rows=[];
  if(nt.voile===true)rows.push(["Voile",nt.voilePose==="dessus"?"Oui — dessus":nt.voilePose==="dessous"?"Oui — dessous":"Oui"]);
  else if(nt.voile===false)rows.push(["Voile","Non"]);
  if(nt.accessoires===true)rows.push(["Accessoires",(nt.accessoiresList||[]).join(", ")||"Oui"]);
  else if(nt.accessoires===false)rows.push(["Accessoires","Non"]);
  if(nt.heureMaquillage)rows.push(["Maquillage",nt.heureMaquillage]);
  if(rows.length){b.appendChild(mkInfoBlock(rows));b.appendChild(mkDivider());}
  if((nt.photos||[]).length){
    var st2=mkDiv("sect-title",null,{fontSize:"11px",fontWeight:"700",color:"#bbb",textTransform:"uppercase",letterSpacing:"1px",marginBottom:"8px"});st2.textContent="Photos essai";b.appendChild(st2);
    var grid=mkDiv("pgrid");(nt.photos||[]).forEach(function(p){var img=document.createElement("img");img.src=p;img.alt="";grid.appendChild(img);});
    b.appendChild(grid);b.appendChild(mkDivider());
  }
  if(nt.notes){
    var st3=mkDiv("sect-title",null,{fontSize:"11px",fontWeight:"700",color:"#bbb",textTransform:"uppercase",letterSpacing:"1px",marginBottom:"8px"});st3.textContent="Notes";b.appendChild(st3);
    var nv=mkDiv("",null,{fontSize:"14px",color:"#333",lineHeight:"1.65",whiteSpace:"pre-wrap"});nv.textContent=nt.notes;b.appendChild(nv);b.appendChild(mkDivider());
  }
  if(!rows.length&&!(nt.stylePresets||[]).length&&!(nt.photos||[]).length&&!nt.notes){var em=mkDiv("empty");em.innerHTML="<p>Aucune note</p>";b.appendChild(em);}
  var eb=mkBtn("btn-secondary","Modifier les notes",function(){openEditWedding(w,"notes");});eb.style.width="100%";b.appendChild(eb);
  return b;
}

function tabVendors(w) {
  var v=w.vendors||{},b=mkDiv("");
  var LIST=[["weddingPlanner","Wedding Planner"],["photographe","Photographe"],["videaste","Vidéaste"],["fleuriste","Fleuriste"],["mua","MUA"],["robe","Robe"],["costume","Costume"],["autres","Autres"]];
  var filled=LIST.filter(function(x){return v[x[0]];});
  if(!filled.length){var em=mkDiv("empty");em.innerHTML="<p>Aucun prestataire</p>";b.appendChild(em);}
  else b.appendChild(mkInfoBlock(filled.map(function(x){return[x[1],v[x[0]]||"—"];})));
  var eb=mkBtn("btn-secondary","Modifier les prestataires",function(){openEditWedding(w,"vendors");});eb.style.cssText="width:100%;margin-top:4px;";b.appendChild(eb);
  return b;
}

function tabContrat(w) {
  var contrat=w.contrat||[],b=mkDiv("");
  var st=mkDiv("sect-title",null,{fontSize:"11px",fontWeight:"700",color:"#bbb",textTransform:"uppercase",letterSpacing:"1px",marginBottom:"8px"});st.textContent="Contrat signé";b.appendChild(st);
  if(!contrat.length){var em=mkDiv("empty");em.innerHTML="<p>Aucun contrat importé</p>";b.appendChild(em);}
  else contrat.forEach(function(item){
    if(item.type==="image"){var img=document.createElement("img");img.src=item.data;img.style.cssText="width:100%;border-radius:8px;margin-bottom:8px;cursor:pointer;";img.addEventListener("click",function(){window.open(item.data,"_blank");});b.appendChild(img);}
    else{var a=document.createElement("a");a.href=item.data;a.download="contrat.pdf";a.target="_blank";a.className="btn-secondary";a.style.cssText="display:block;width:100%;text-align:center;text-decoration:none;margin-bottom:8px;padding:12px;box-sizing:border-box;";a.textContent="Contrat — Ouvrir";b.appendChild(a);}
  });
  var expBtn=mkBtn("btn-primary","Exporter la fiche en PDF",function(){exportPDF(w);});expBtn.style.cssText="width:100%;margin-top:12px;";b.appendChild(expBtn);
  var editBtn=mkBtn("btn-secondary","Modifier le contrat",function(){openEditWedding(w,"contrat");});editBtn.style.cssText="width:100%;margin-top:8px;";b.appendChild(editBtn);
  return b;
}

function exportPDF(w) {
  var pay=w.payment||{};
  var f=parseFloat(pay.forfait)||0,km=parseFloat(pay.km)||0,pk=parseFloat(pay.prixKm)||1;
  var frais=km*pk,total=f+frais,ac=parseFloat(pay.acompteAmount)||0,reste=Math.max(0,total-ac);
  var nt=w.notesTab||{};
  var fd=w.date?fmtDate(w.date):null;
  var dateStr=fd?fd.dayName+" "+fd.day+" "+fd.month+" "+fd.year:"—";
  var html="<!DOCTYPE html><html><head><meta charset=\"UTF-8\"/><meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\"/><style>body{font-family:Georgia,serif;color:#1a1a1a;padding:20px;max-width:700px;margin:0 auto;}h1{font-size:22px;font-weight:700;margin-bottom:4px;}h2{font-size:14px;color:#5b9ab5;text-transform:uppercase;letter-spacing:1px;margin:20px 0 8px;border-bottom:1px solid #eee;padding-bottom:4px;}.row{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid #f5f5f5;font-size:13px;}.lbl{color:#999;}.val{font-weight:500;text-align:right;}.total{background:#1a1a1a;color:#fff;padding:12px 16px;border-radius:8px;margin:10px 0;}.total-val{font-size:28px;font-weight:300;}.toolbar{display:flex;gap:10px;margin-bottom:24px;position:sticky;top:0;background:#fff;padding:12px 0;border-bottom:1px solid #eee;}.btn-close{background:#f0f0f0;border:none;padding:12px 20px;border-radius:8px;font-size:15px;font-weight:600;cursor:pointer;color:#333;flex:1;}.btn-print{background:#5b9ab5;border:none;padding:12px 20px;border-radius:8px;font-size:15px;font-weight:600;cursor:pointer;color:#fff;flex:2;}@media print{.toolbar{display:none;}}</style></head><body>";
  html+="<div class=\"toolbar\"><button class=\"btn-close\" onclick=\"window.close()\">← Fermer</button><button class=\"btn-print\" onclick=\"window.print()\">Enregistrer en PDF</button></div>";
  html+="<h1>"+(w.names||"Sans nom")+"</h1><p style=\"color:#999;font-size:12px;\">"+dateStr+"</p>";
  html+="<h2>Informations</h2>";
  html+='<div class="row"><span class="lbl">Forfait</span><span class="val">'+(w.forfait||"—")+"</span></div>";
  html+='<div class="row"><span class="lbl">Lieu</span><span class="val">'+(w.location||"—")+"</span></div>";
  html+='<div class="row"><span class="lbl">Arrivée</span><span class="val">'+(w.arrivalTime||"—")+"</span></div>";
  html+='<div class="row"><span class="lbl">Téléphone</span><span class="val">'+(w.phone||"—")+"</span></div>";
  html+='<div class="row"><span class="lbl">Email</span><span class="val">'+(w.email||"—")+"</span></div>";
  html+="<h2>Paiement</h2>";
  html+='<div class="total"><div style="font-size:10px;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:1px;margin-bottom:6px;">Total à payer</div><div class="total-val">'+(total>0?total.toFixed(2)+" €":"—")+"</div></div>";
  html+='<div class="row"><span class="lbl">Reste à payer</span><span class="val">'+(reste===0?"Soldé ✓":reste.toFixed(2)+" €")+"</span></div>";
  if(nt.notes)html+="<h2>Notes</h2><p style=\"font-size:13px;line-height:1.65;white-space:pre-wrap;\">"+nt.notes+"</p>";
  html+="</body></html>";
  var win=window.open("","_blank");
  win.document.write(html);
  win.document.close();
  win.focus();
}

// ══ FORM ════════════════════════════════════════════════
function openNewWedding()       { SEL_DATE=null; FORM_TAB="info"; openFormWith(emptyW(null)); }
function openNewWeddingOnDate() { FORM_TAB="info"; openFormWith(emptyW(SEL_DATE)); }
function openEditWedding(w,tab) { FORM_TAB=tab||"info"; openFormWith(JSON.parse(JSON.stringify(w))); }
function cancelForm()           { showPage(SEL_DATE?"day":"cal"); }

function openFormWith(w) {
  FORM=w;
  document.getElementById("form-title").textContent=w.names?"Modifier":"Nouveau mariage";
  showFormError(null);
  buildFormTabs();
  buildFormBody();
  showPage("form");
}
function buildFormTabs() {
  var TABS=[["info","Infos"],["payment","Paiement"],["planning","Planning"],["notes","Notes"],["vendors","Prestataires"],["contrat","Contrat"]];
  var bar=document.getElementById("ftabs");bar.innerHTML="";
  TABS.forEach(function(t){
    var b=mkBtn("ftab"+(FORM_TAB===t[0]?" on":""),t[1],null);
    (function(id){b.addEventListener("click",function(){FORM_TAB=id;buildFormTabs();buildFormBody();});})(t[0]);
    bar.appendChild(b);
  });
}
function buildFormBody() {
  var body=document.getElementById("form-body");body.innerHTML="";
  showFormError(null);
  if(FORM_TAB==="info")body.appendChild(buildFInfo());
  else if(FORM_TAB==="payment")body.appendChild(buildFPayment());
  else if(FORM_TAB==="planning")body.appendChild(buildFPlanning());
  else if(FORM_TAB==="notes")body.appendChild(buildFNotes());
  else if(FORM_TAB==="vendors")body.appendChild(buildFVendors());
  else if(FORM_TAB==="contrat")body.appendChild(buildFContrat());
}

async function saveWedding() {
  showFormError(null);
  if(document.activeElement)document.activeElement.blur();
  await new Promise(function(r){setTimeout(r,80);});
  if(!FORM.names||!FORM.names.trim()){showFormError("Veuillez saisir un nom pour les mariés.");return;}
  var saved=JSON.parse(JSON.stringify(FORM));
  var existing=WEDDINGS.find(function(x){return x.id===saved.id;});
  try{
    if(existing)WEDDINGS=WEDDINGS.map(function(x){return x.id===saved.id?saved:x;});
    else WEDDINGS.push(saved);
    await persistW(saved);
    if(saved.date){CAL.year=parseInt(saved.date.split("-")[0]);CAL.month=parseInt(saved.date.split("-")[1])-1;}
    SEL_DATE=saved.date;buildCal();buildDayPage();showPage("day");
    showToast(existing?"Mis à jour ✓":"Mariage ajouté ✓");
  }catch(e){showFormError("Erreur sauvegarde. Vérifiez votre connexion.");}
}

// ── Field helpers ───────────────────────────────────────
function fLabel(txt){var l=document.createElement("label");l.textContent=txt;return l;}
function fText(label,key,ph,type){
  var f=mkDiv("field");f.appendChild(fLabel(label));
  var i=document.createElement("input");i.type=type||"text";i.value=FORM[key]||"";i.placeholder=ph||"";
  i.addEventListener("input",function(e){FORM[key]=e.target.value;});
  i.addEventListener("change",function(e){FORM[key]=e.target.value;});
  f.appendChild(i);return f;
}
function fTime(label,key){
  var f=mkDiv("field");f.appendChild(fLabel(label));
  var i=document.createElement("input");i.type="time";i.value=FORM[key]||"";
  i.addEventListener("change",function(e){FORM[key]=e.target.value;});
  i.addEventListener("input",function(e){FORM[key]=e.target.value;});
  f.appendChild(i);return f;
}
function fPayNum(label,key,ph){
  var f=mkDiv("field");f.appendChild(fLabel(label));
  var i=document.createElement("input");i.type="number";i.inputMode="decimal";i.value=FORM.payment[key]||"";i.placeholder=ph||"";
  i.addEventListener("input",function(e){FORM.payment[key]=e.target.value;renderPayCard();});
  i.addEventListener("change",function(e){FORM.payment[key]=e.target.value;renderPayCard();});
  f.appendChild(i);return f;
}

// ── FORM: INFO ──────────────────────────────────────────
function buildFInfo(){
  var b=mkDiv("");
  b.appendChild(fText("Nom(s) des futurs mariés","names","Ex : Sophie & Julien"));
  b.appendChild(fText("Téléphone","phone","06 12 34 56 78","tel"));
  b.appendChild(fText("Email","email","sophie@mail.com","email"));
  // Publication
  var pubd=mkDiv("field");pubd.appendChild(fLabel("Autorisation de publication"));
  var prow=mkDiv("choices");
  [{val:true,lbl:"Oui"},{val:false,lbl:"Non"}].forEach(function(opt){
    var isOn=FORM.publicationOk===opt.val;
    var bn=mkBtn("choice"+(isOn?" on":""),opt.lbl,null);
    (function(v){bn.addEventListener("click",function(){FORM.publicationOk=v;buildFormBody();});})(opt.val);
    prow.appendChild(bn);
  });
  pubd.appendChild(prow);b.appendChild(pubd);
  // Statut
  var sf=mkDiv("field");sf.appendChild(fLabel("Statut"));
  var sel=document.createElement("select");
  sel.addEventListener("change",function(e){FORM.status=e.target.value;});
  [["pending","À confirmer"],["confirme","Confirmé"],["complet","Complet"],["equipe1","Équipe 1"],["equipe2","Équipe 2"],["equipe3","Équipe 3"]].forEach(function(x){
    var o=new Option(x[1],x[0]);if(FORM.status===x[0])o.selected=true;sel.appendChild(o);
  });
  sf.appendChild(sel);b.appendChild(sf);
  // Forfait
  var forf=mkDiv("field");forf.appendChild(fLabel("Forfait choisi"));
  var fsel=document.createElement("select");
  fsel.addEventListener("change",function(e){FORM.forfait=e.target.value;});
  [["","Choisir…"],["Sirène","Sirène"],["Empire","Empire"],["Princesse","Princesse"]].forEach(function(x){
    var o=new Option(x[1],x[0]);if(FORM.forfait===x[0])o.selected=true;fsel.appendChild(o);
  });
  forf.appendChild(fsel);b.appendChild(forf);
  // Nb invités
  var nbf=mkDiv("field");nbf.appendChild(fLabel("Nombre d'invités à coiffer"));
  var nbi=document.createElement("input");nbi.type="number";nbi.inputMode="numeric";nbi.value=FORM.nbInvites||"";nbi.placeholder="Ex : 5";
  nbi.addEventListener("input",function(e){FORM.nbInvites=e.target.value;});
  nbi.addEventListener("change",function(e){FORM.nbInvites=e.target.value;});
  nbf.appendChild(nbi);b.appendChild(nbf);
  // Date
  var df=mkDiv("field");df.appendChild(fLabel("Date"));
  var di=document.createElement("input");di.type="date";di.value=FORM.date||"";
  var hint=mkDiv("hint");
  function updateHint(v){if(!v)return;hint.textContent=isSat(v)?"Samedi — priorité mariage":"Attention : pas un samedi";hint.style.color=isSat(v)?"#5b9ab5":"#b08040";}
  updateHint(FORM.date);
  di.addEventListener("change",function(e){FORM.date=e.target.value;updateHint(e.target.value);});
  di.addEventListener("input",function(e){FORM.date=e.target.value;updateHint(e.target.value);});
  df.appendChild(di);df.appendChild(hint);b.appendChild(df);
  // Lieu + Maps
  var lf=mkDiv("field");lf.appendChild(fLabel("Lieu / Domaine"));
  var li=document.createElement("input");li.type="text";li.value=FORM.location||"";li.placeholder="Ex : Château La Borie";
  li.addEventListener("input",function(e){FORM.location=e.target.value;});
  li.addEventListener("change",function(e){FORM.location=e.target.value;});
  lf.appendChild(li);
  var mr=mkDiv("map-row");mr.style.marginTop="8px";
  var a1=document.createElement("a");a1.target="_blank";a1.className="mapbtn blue";a1.textContent="Voir sur Maps";
  var a2=document.createElement("a");a2.target="_blank";a2.className="mapbtn grn";a2.textContent="Waze";
  [a1,a2].forEach(function(a,idx){
    a.addEventListener("click",function(){
      var loc=li.value||FORM.location||"";if(!loc){alert("Saisissez d'abord un lieu");return;}
      a.href=idx===0?"https://www.google.com/maps/search/?api=1&query="+encodeURIComponent(loc):"https://waze.com/ul?q="+encodeURIComponent(loc)+"&navigate=yes";
    });
  });
  mr.appendChild(a1);mr.appendChild(a2);lf.appendChild(mr);b.appendChild(lf);
  // Horaires
  var hr=mkDiv("row2");hr.appendChild(fTime("Arrivée","arrivalTime"));hr.appendChild(fTime("Départ","departureTime"));b.appendChild(hr);
  return b;
}

// ── FORM: PAYMENT ───────────────────────────────────────
function buildFPayment(){
  if(!FORM.payment)FORM.payment={forfait:"",km:"",prixKm:"1",acompteAmount:"",acompteDate:"",acompteReceived:false,invitesMode:"mariee"};
  var b=mkDiv("");
  var tc=mkDiv("pay-total");tc.id="f-pay-card";b.appendChild(tc);renderPayCard();
  b.appendChild(fPayNum("Forfait de base (€)","forfait","Ex : 800"));
  var kr=mkDiv("row2");kr.appendChild(fPayNum("Kilomètres","km","Ex : 150"));kr.appendChild(fPayNum("Prix / km (€)","prixKm","1"));b.appendChild(kr);
  var ar=mkDiv("row2");ar.appendChild(fPayNum("Acompte versé (€)","acompteAmount","Ex : 300"));
  var datef=mkDiv("field");datef.appendChild(fLabel("Date reçu"));
  var di=document.createElement("input");di.type="text";di.value=FORM.payment.acompteDate||"";di.placeholder="01/03/2025";
  di.addEventListener("input",function(e){FORM.payment.acompteDate=e.target.value;});datef.appendChild(di);ar.appendChild(datef);b.appendChild(ar);
  var ckl=document.createElement("label");ckl.className="check-row";
  var ck=document.createElement("input");ck.type="checkbox";if(FORM.payment.acompteReceived)ck.checked=true;
  ck.addEventListener("change",function(e){FORM.payment.acompteReceived=e.target.checked;});
  var cks=document.createElement("span");cks.textContent="Acompte bien reçu";
  ckl.appendChild(ck);ckl.appendChild(cks);b.appendChild(ckl);
  var ilf=mkDiv("field");ilf.appendChild(fLabel("Règlement des invités"));
  var ir=mkDiv("inv-row");
  [{val:"mariee",lbl:"Par la mariée",sub:"Règlement global"},{val:"individuel",lbl:"Individuel",sub:"Chaque invité"}].forEach(function(opt){
    var isOn=FORM.payment.invitesMode===opt.val;
    var ob=mkDiv("inv-choice"+(isOn?" on":""));
    var il=mkDiv("inv-choice-lbl");il.textContent=opt.lbl;
    var is=mkDiv("inv-choice-sub");is.textContent=opt.sub;
    ob.appendChild(il);ob.appendChild(is);
    (function(v){ob.addEventListener("click",function(){FORM.payment.invitesMode=v;buildFormBody();});})(opt.val);
    ir.appendChild(ob);
  });
  ilf.appendChild(ir);b.appendChild(ilf);
  return b;
}
function renderPayCard(){
  var card=document.getElementById("f-pay-card");if(!card)return;
  var p=FORM.payment||{};
  var f=parseFloat(p.forfait)||0,km=parseFloat(p.km)||0,pk=parseFloat(p.prixKm)||1;
  var frais=km*pk,total=f+frais,ac=parseFloat(p.acompteAmount)||0,reste=Math.max(0,total-ac);
  card.innerHTML="<div class=\"pay-total-lbl\">Total à payer</div><div class=\"pay-total-val\">"+(total>0?total.toFixed(2)+" €":"—")+"</div>";
  if(ac>0){var ts=mkDiv("pay-total-sub");ts.innerHTML="Acompte : "+ac.toFixed(2)+" € → <span style=\"color:"+(reste===0?"#7fd87f":"#ffcc70")+";font-weight:600\">"+(reste===0?"Soldé":"Reste "+reste.toFixed(2)+" €")+"</span>";card.appendChild(ts);}
}

// ── FORM: PLANNING ──────────────────────────────────────
function buildFPlanning(){
  if(!FORM.coiffeuses)FORM.coiffeuses=[];
  var b=mkDiv("");
  var hr=mkDiv("row2");hr.appendChild(fTime("Arrivée","arrivalTime"));hr.appendChild(fTime("Départ cérémonie","departureTime"));b.appendChild(hr);
  var tip=mkDiv("",null,{fontSize:"12px",color:"#bbb",marginBottom:"14px",lineHeight:"1.5"});tip.textContent="Ajoutez une coiffeuse puis ses clientes. Créneaux de 45 min calculés automatiquement.";b.appendChild(tip);
  var coifContainer=mkDiv("");coifContainer.id="coif-container";b.appendChild(coifContainer);
  renderCoifContainer(coifContainer);
  var addBtn=mkBtn("btn-primary","+ Ajouter une coiffeuse",function(){FORM.coiffeuses.push({id:uid(),name:"",clients:[]});renderCoifContainer(coifContainer);updateFinBox();});
  addBtn.style.width="100%";b.appendChild(addBtn);
  var finBox=mkDiv("");finBox.id="fin-box";b.appendChild(finBox);updateFinBox();
  return b;
}
function renderCoifContainer(container){
  container.innerHTML="";
  FORM.coiffeuses.forEach(function(cf,ci){container.appendChild(buildCoifBlock(cf,ci,container));});
}
function buildCoifBlock(cf,ci,container){
  var COLORS=["#9b7fc4","#c87090","#5b9ab5","#8aab8c"];
  var blk=mkDiv("coif-form-blk");
  var hdr=mkDiv("coif-form-hdr");
  var dot=mkEl("span","");dot.style.cssText="display:inline-block;width:8px;height:8px;border-radius:50%;background:"+(COLORS[ci]||"#ccc")+";margin-right:8px;flex-shrink:0;";
  var ni=document.createElement("input");ni.className="coif-name-inp";ni.type="text";ni.value=cf.name||"";ni.placeholder="Coiffeuse "+(ci+1)+" — Prénom";
  ni.addEventListener("input",function(e){FORM.coiffeuses[ci].name=e.target.value;});
  ni.addEventListener("change",function(e){FORM.coiffeuses[ci].name=e.target.value;});
  var hl=mkDiv("",null,{display:"flex",alignItems:"center",flex:"1",minWidth:"0"});hl.appendChild(dot);hl.appendChild(ni);
  var delBtn=mkBtn("btn-danger","Retirer",null);delBtn.style.cssText="padding:4px 10px;font-size:12px;flex-shrink:0;";
  (function(idx){delBtn.addEventListener("click",function(){FORM.coiffeuses.splice(idx,1);renderCoifContainer(container);updateFinBox();});})(ci);
  hdr.appendChild(hl);hdr.appendChild(delBtn);blk.appendChild(hdr);
  var body=mkDiv("coif-form-body");
  var clientsContainer=mkDiv("");body.appendChild(clientsContainer);
  renderClients(clientsContainer,ci);
  var addClientBtn=mkBtn("btn-secondary","+ Ajouter une cliente",null);addClientBtn.style.cssText="font-size:12px;padding:6px 12px;margin-top:4px;";
  (function(idx){addClientBtn.addEventListener("click",function(){if(!FORM.coiffeuses[idx].clients)FORM.coiffeuses[idx].clients=[];FORM.coiffeuses[idx].clients.push({id:uid(),person:"",style:"",orientation:"",startTime:"",duration:45});renderClients(clientsContainer,idx);updateFinBox();});})(ci);
  body.appendChild(addClientBtn);blk.appendChild(body);
  return blk;
}
function renderClients(container,ci){
  container.innerHTML="";
  (FORM.coiffeuses[ci].clients||[]).forEach(function(cl,clidx){
    var defaultStart=addMin(FORM.arrivalTime||"08:00",clidx*45);
    var start=cl.startTime||defaultStart;
    var dur=parseInt(cl.duration)||45;
    var end=addMin(start,dur);
    var row=mkDiv("client-row");
    var tInp=document.createElement("input");tInp.type="time";tInp.value=start;tInp.className="client-time-inp";
    (function(idx){tInp.addEventListener("change",function(e){FORM.coiffeuses[ci].clients[idx].startTime=e.target.value;recascadeFrom(ci,idx+1);renderClients(container,ci);updateFinBox();});})(clidx);
    var dInp=document.createElement("input");dInp.type="number";dInp.value=dur;dInp.min="5";dInp.className="client-dur-inp";
    (function(idx){dInp.addEventListener("change",function(e){FORM.coiffeuses[ci].clients[idx].duration=parseInt(e.target.value)||45;recascadeFrom(ci,idx+1);renderClients(container,ci);updateFinBox();});})(clidx);
    var durLbl=mkDiv("client-dur-lbl");durLbl.textContent="min";
    var endLbl=mkDiv("client-end-lbl");endLbl.textContent="→ "+end;
    var ni=document.createElement("input");ni.type="text";ni.value=cl.person||"";ni.placeholder="Prénom";ni.className="client-inp";
    (function(idx){ni.addEventListener("input",function(e){FORM.coiffeuses[ci].clients[idx].person=e.target.value;});ni.addEventListener("change",function(e){FORM.coiffeuses[ci].clients[idx].person=e.target.value;});})(clidx);
    var dc=document.createElement("button");dc.className="client-del";dc.textContent="×";
    (function(idx){dc.addEventListener("click",function(){FORM.coiffeuses[ci].clients.splice(idx,1);recascadeFrom(ci,idx);renderClients(container,ci);updateFinBox();});})(clidx);
    row.appendChild(tInp);row.appendChild(dInp);row.appendChild(durLbl);row.appendChild(endLbl);row.appendChild(ni);row.appendChild(dc);
    container.appendChild(row);
    var ss=document.createElement("select");ss.className="style-sel";
    [["","Style…"]].concat(STYLES.map(function(s){return[s,s];})).forEach(function(x){var o=new Option(x[1],x[0]);if((cl.style||"")===x[0])o.selected=true;ss.appendChild(o);});
    (function(idx){ss.addEventListener("change",function(e){FORM.coiffeuses[ci].clients[idx].style=e.target.value;});})(clidx);
    container.appendChild(ss);
  });
}
function recascadeFrom(ci,fromIdx){
  var clients=FORM.coiffeuses[ci].clients||[];
  for(var i=fromIdx;i<clients.length;i++){
    var prev=clients[i-1];if(!prev)break;
    var prevDur=parseInt(prev.duration)||45;
    clients[i].startTime=addMin(prev.startTime||FORM.arrivalTime||"08:00",prevDur);
  }
}
function updateFinBox(){
  var box=document.getElementById("fin-box");if(!box)return;box.innerHTML="";
  var latestEnd="";
  (FORM.coiffeuses||[]).forEach(function(cf){(cf.clients||[]).forEach(function(cl){var dur=parseInt(cl.duration)||45;var end=addMin(cl.startTime||FORM.arrivalTime||"08:00",dur);if(!latestEnd||end>latestEnd)latestEnd=end;});});
  if(latestEnd){
    box.className="fin-box";
    var lbl=mkDiv("",null,{fontSize:"11px",fontWeight:"700",color:"#bbb",textTransform:"uppercase",letterSpacing:"1px",marginBottom:"4px"});lbl.textContent="Fin estimée des coiffages";
    var val=mkDiv("",null,{fontSize:"18px",fontWeight:"700",color:"#333"});val.textContent=latestEnd;
    box.appendChild(lbl);box.appendChild(val);
  }
}

// ── FORM: NOTES ─────────────────────────────────────────
function buildFNotes(){
  if(!FORM.notesTab)FORM.notesTab={stylePresets:[],orientationPresets:[],voile:null,voilePose:"",accessoires:null,accessoiresList:[],heureMaquillage:"",photos:[],notes:""};
  var nt=FORM.notesTab,b=mkDiv("");
  // Styles
  var sf=mkDiv("field");sf.appendChild(fLabel("Style de coiffure — Essai"));var sr=mkDiv("tag-row");
  STYLES.forEach(function(opt){var isOn=(nt.stylePresets||[]).indexOf(opt)>=0;var t=mkBtn("tag"+(isOn?" sky":""),opt,null);(function(o,btn){btn.addEventListener("click",function(){var cur=FORM.notesTab.stylePresets||[];var inList=cur.indexOf(o)>=0;FORM.notesTab.stylePresets=inList?cur.filter(function(x){return x!==o;}):[].concat(cur,[o]);btn.className="tag"+(FORM.notesTab.stylePresets.indexOf(o)>=0?" sky":"");});})( opt,t);sr.appendChild(t);});
  sf.appendChild(sr);b.appendChild(sf);
  // Orientation
  var of=mkDiv("field");of.appendChild(fLabel("Orientation"));var or=mkDiv("tag-row");
  ORIENTS.forEach(function(opt){var isOn=(nt.orientationPresets||[]).indexOf(opt)>=0;var t=mkBtn("tag"+(isOn?" gld":""),opt,null);(function(o,btn){btn.addEventListener("click",function(){var cur=FORM.notesTab.orientationPresets||[];var inList=cur.indexOf(o)>=0;FORM.notesTab.orientationPresets=inList?cur.filter(function(x){return x!==o;}):[].concat(cur,[o]);btn.className="tag"+(FORM.notesTab.orientationPresets.indexOf(o)>=0?" gld":"");});})( opt,t);or.appendChild(t);});
  of.appendChild(or);b.appendChild(of);
  // Voile
  var vf=mkDiv("field");vf.appendChild(fLabel("Voile"));var vrow=mkDiv("choices");
  [{val:true,lbl:"Oui"},{val:false,lbl:"Non"}].forEach(function(opt){var isOn=nt.voile===opt.val;var bn=mkBtn("choice"+(isOn?" on":""),opt.lbl,null);(function(v){bn.addEventListener("click",function(){FORM.notesTab.voile=v;buildFormBody();});})(opt.val);vrow.appendChild(bn);});
  vf.appendChild(vrow);
  if(nt.voile===true){
    var vpose=mkDiv("field");vpose.style.marginTop="8px";vpose.appendChild(fLabel("Pose du voile"));var vprow=mkDiv("choices");
    [{val:"dessus",lbl:"Dessus la coiffure"},{val:"dessous",lbl:"Dessous la coiffure"}].forEach(function(opt){var isOn=nt.voilePose===opt.val;var bn=mkBtn("choice"+(isOn?" on":""),opt.lbl,null);bn.style.fontSize="11px";(function(v){bn.addEventListener("click",function(){FORM.notesTab.voilePose=v;buildFormBody();});})(opt.val);vprow.appendChild(bn);});
    vpose.appendChild(vprow);vf.appendChild(vpose);
  }
  b.appendChild(vf);
  // Accessoires
  var acf=mkDiv("field");acf.appendChild(fLabel("Accessoires"));var acrow=mkDiv("choices");
  [{val:true,lbl:"Oui"},{val:false,lbl:"Non"}].forEach(function(opt){var isOn=nt.accessoires===opt.val;var bn=mkBtn("choice"+(isOn?" on":""),opt.lbl,null);(function(v){bn.addEventListener("click",function(){FORM.notesTab.accessoires=v;buildFormBody();});})(opt.val);acrow.appendChild(bn);});
  acf.appendChild(acrow);
  if(nt.accessoires===true){
    var acopts=["Fleurs","Broches","Épingles","Couronne","Autres"];var aclist=mkDiv("tag-row");aclist.style.marginTop="8px";
    acopts.forEach(function(opt){var isOn=(nt.accessoiresList||[]).indexOf(opt)>=0;var t=mkBtn("tag"+(isOn?" sky":""),opt,null);(function(o,btn){btn.addEventListener("click",function(){var cur=FORM.notesTab.accessoiresList||[];var inList=cur.indexOf(o)>=0;FORM.notesTab.accessoiresList=inList?cur.filter(function(x){return x!==o;}):[].concat(cur,[o]);btn.className="tag"+(FORM.notesTab.accessoiresList.indexOf(o)>=0?" sky":"");});})( opt,t);aclist.appendChild(t);});
    acf.appendChild(aclist);
  }
  b.appendChild(acf);
  // Heure maquillage
  var hf=mkDiv("field");hf.appendChild(fLabel("Heure de maquillage"));
  var hi=document.createElement("input");hi.type="time";hi.value=nt.heureMaquillage||"";
  hi.addEventListener("change",function(e){FORM.notesTab.heureMaquillage=e.target.value;});hi.addEventListener("input",function(e){FORM.notesTab.heureMaquillage=e.target.value;});
  hf.appendChild(hi);b.appendChild(hf);
  // Photos
  var pf=mkDiv("field");pf.appendChild(fLabel("Photos de l'essai"));
  var fr=document.createElement("input");fr.type="file";fr.accept="image/*";fr.style.display="none";
  fr.addEventListener("change",function(e){var f=e.target.files[0];if(!f)return;var r=new FileReader();r.onload=function(ev){if(!FORM.notesTab.photos)FORM.notesTab.photos=[];FORM.notesTab.photos.push(ev.target.result);buildFormBody();};r.readAsDataURL(f);});
  pf.appendChild(fr);
  var fpb=mkBtn("btn-secondary","Ajouter une photo",function(){fr.click();});fpb.style.width="100%";pf.appendChild(fpb);
  if((nt.photos||[]).length){
    var grid=mkDiv("pgrid");grid.style.marginTop="8px";
    (nt.photos||[]).forEach(function(p,i){var wrap=mkDiv("pwrap");var img=document.createElement("img");img.src=p;img.alt="";var del=document.createElement("button");del.className="pdel";del.textContent="×";(function(idx){del.addEventListener("click",function(){FORM.notesTab.photos.splice(idx,1);buildFormBody();});})(i);wrap.appendChild(img);wrap.appendChild(del);grid.appendChild(wrap);});
    pf.appendChild(grid);
  }
  b.appendChild(pf);
  // Notes libres
  var nf=mkDiv("field");nf.appendChild(fLabel("Notes libres"));
  var ta=document.createElement("textarea");ta.rows=7;ta.placeholder="Observations, souhaits…";ta.value=nt.notes||"";
  ta.addEventListener("input",function(e){FORM.notesTab.notes=e.target.value;});ta.addEventListener("change",function(e){FORM.notesTab.notes=e.target.value;});
  nf.appendChild(ta);b.appendChild(nf);
  return b;
}

// ── FORM: VENDORS ───────────────────────────────────────
function buildFVendors(){
  if(!FORM.vendors)FORM.vendors={};var v=FORM.vendors,b=mkDiv("");
  [["weddingPlanner","Wedding Planner"],["photographe","Photographe"],["videaste","Vidéaste"],["fleuriste","Fleuriste"],["mua","MUA"],["robe","Robe"],["costume","Costume"],["autres","Autres"]].forEach(function(x){
    var f=mkDiv("field");f.appendChild(fLabel(x[1]));
    var ta=document.createElement("textarea");ta.rows=2;ta.placeholder="Nom, tél, email…";ta.value=v[x[0]]||"";
    (function(k){ta.addEventListener("input",function(e){FORM.vendors[k]=e.target.value;});ta.addEventListener("change",function(e){FORM.vendors[k]=e.target.value;});})(x[0]);
    f.appendChild(ta);b.appendChild(f);
  });
  return b;
}

// ── FORM: CONTRAT ───────────────────────────────────────
function buildFContrat(){
  if(!FORM.contrat)FORM.contrat=[];var b=mkDiv("");
  var st=mkDiv("",null,{fontSize:"11px",fontWeight:"700",color:"#bbb",textTransform:"uppercase",letterSpacing:"1px",marginBottom:"8px"});st.textContent="Importer le contrat signé";b.appendChild(st);
  var tip=mkDiv("",null,{fontSize:"12px",color:"#bbb",marginBottom:"14px",lineHeight:"1.5"});tip.textContent="Importez une photo ou un PDF du contrat signé.";b.appendChild(tip);
  var frImg=document.createElement("input");frImg.type="file";frImg.accept="image/*";frImg.style.display="none";
  frImg.addEventListener("change",function(e){var f=e.target.files[0];if(!f)return;var r=new FileReader();r.onload=function(ev){FORM.contrat.push({type:"image",data:ev.target.result,name:f.name});buildFormBody();};r.readAsDataURL(f);});
  b.appendChild(frImg);
  var btnImg=mkBtn("btn-secondary","Importer une photo du contrat",function(){frImg.click();});btnImg.style.cssText="width:100%;margin-bottom:10px;";b.appendChild(btnImg);
  var frPdf=document.createElement("input");frPdf.type="file";frPdf.accept="application/pdf";frPdf.style.display="none";
  frPdf.addEventListener("change",function(e){var f=e.target.files[0];if(!f)return;var r=new FileReader();r.onload=function(ev){FORM.contrat.push({type:"pdf",data:ev.target.result,name:f.name});buildFormBody();};r.readAsDataURL(f);});
  b.appendChild(frPdf);
  var btnPdf=mkBtn("btn-secondary","Importer un PDF du contrat",function(){frPdf.click();});btnPdf.style.cssText="width:100%;margin-bottom:16px;";b.appendChild(btnPdf);
  if(FORM.contrat.length){
    var st2=mkDiv("",null,{fontSize:"11px",fontWeight:"700",color:"#bbb",textTransform:"uppercase",letterSpacing:"1px",marginBottom:"8px"});st2.textContent="Fichiers importés";b.appendChild(st2);
    FORM.contrat.forEach(function(item,i){
      var row=mkDiv("",null,{display:"flex",alignItems:"center",justifyContent:"space-between",padding:"10px 13px",background:"#f9f9f9",borderRadius:"8px",border:"1px solid #eee",marginBottom:"8px"});
      var lbl=mkDiv("",null,{fontSize:"13px",color:"#333",flex:"1",overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap"});lbl.textContent=(item.type==="pdf"?"PDF: ":"Photo: ")+(item.name||"Contrat");
      var del=mkBtn("btn-danger","Retirer",null);del.style.cssText="padding:4px 10px;font-size:12px;flex-shrink:0;margin-left:8px;";(function(idx){del.addEventListener("click",function(){FORM.contrat.splice(idx,1);buildFormBody();});})(i);
      row.appendChild(lbl);row.appendChild(del);b.appendChild(row);
    });
  }
  b.appendChild(mkDivider());
  var expBtn=mkBtn("btn-primary","Exporter la fiche complète en PDF",function(){exportPDF(FORM);});expBtn.style.width="100%";b.appendChild(expBtn);
  return b;
}

// ══ BOOT ════════════════════════════════════════════════
(function init(){
  if(sessionStorage.getItem(AUTH_KEY)==="1"){
    document.getElementById("login-screen").style.display="none";
    document.getElementById("loading-screen").style.display="flex";
    loadAll();
  } else {
    document.getElementById("login-screen").style.display="flex";
    document.getElementById("loading-screen").style.display="none";
    setTimeout(function(){var i=document.getElementById("pwd-input");if(i)i.focus();},100);
  }
})();
</script>
</body>
</html>
